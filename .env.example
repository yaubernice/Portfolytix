# Copy to `.env` for local (non-Docker) runs.
# Docker Compose sets equivalent values for the `api` service itself.
# Never commit a real `.env`.

APP_NAME=FinSight
ENVIRONMENT=local
LOG_LEVEL=INFO

# Host process talking to Postgres published on localhost:15432
# Inside Compose, the API uses host `db` instead of `localhost`.
DATABASE_URL=postgresql+psycopg://finsight:finsight@localhost:15432/finsight

# Analytics (Sharpe). Annual decimal; 0.05 = 5%. Not a forecast.
RISK_FREE_RATE=0.05
TRADING_DAYS_PER_YEAR=252

# Market data. stooq needs no key. alpha_vantage needs MARKET_DATA_API_KEY.
MARKET_DATA_PROVIDER=stooq
MARKET_DATA_API_KEY=

# Phase 6 scheduler. 22:00 UTC is after the US cash close (EST and EDT).
SCHEDULER_ENABLED=true
MARKET_DATA_CRON=0 22 * * *
MARKET_DATA_LOOKBACK_DAYS=7
# One ingest stays inside these bounds. Raise the pause for a rate-limited key.
MARKET_DATA_MAX_SECURITIES=25
MARKET_DATA_MAX_WINDOW_DAYS=1825
MARKET_DATA_MAX_ATTEMPTS=3
MARKET_DATA_RETRY_BACKOFF_SECONDS=0
MARKET_DATA_PAUSE_SECONDS=0
# true asks Alpha Vantage for its full daily history. Leave false otherwise.
MARKET_DATA_ALLOW_FULL_HISTORY=false
JOB_STALE_AFTER_SECONDS=3600

# Phase 9 cache. Host Redis is published on 16379; Compose uses redis:6379.
CACHE_ENABLED=true
REDIS_URL=redis://localhost:16379/0
CACHE_KEY_PREFIX=finsight
ANALYTICS_CACHE_TTL_SECONDS=300
SCREENING_CACHE_TTL_SECONDS=300
REDIS_SOCKET_TIMEOUT_SECONDS=0.2

# Phase 10 auth. Generate a long random secret outside local development.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=finsight
JWT_ACCESS_TOKEN_MINUTES=30

# Phase 12 assistant. local needs no key. openai sends evidence, not SQL.
AI_PROVIDER=local
# responses uses OpenAI's native API; chat retains compatible-provider fallback.
AI_OPENAI_API=responses
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
AI_FALLBACK_TO_LOCAL=true

# Live quotes. simulator needs no key and does not write ticks to PostgreSQL.
# finnhub uses the WebSocket trade stream. alpha_vantage polls GLOBAL_QUOTE.
QUOTE_PROVIDER=simulator
QUOTE_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA
QUOTE_POLL_SECONDS=2
QUOTE_TTL_SECONDS=30
QUOTE_STALE_AFTER_SECONDS=15
# Delayed quotes stay delayed until this long since the last successful refresh.
QUOTE_DELAYED_STALE_AFTER_SECONDS=120
# Stored daily bars older than this many sessions are stale. Weekends and
# NYSE holidays do not count as sessions.
HISTORY_STALE_AFTER_BUSINESS_DAYS=3
QUOTE_WORKER_HEARTBEAT_TTL_SECONDS=30
QUOTE_MAX_SYMBOLS=50
QUOTE_RECONNECT_SECONDS=2
QUOTE_SYMBOL_REFRESH_SECONDS=30
# true only when the Alpha Vantage key is entitled to realtime GLOBAL_QUOTE.
ALPHA_VANTAGE_REALTIME=false
# Empty uses the quote provider when that provider has news.
# yahoo needs no key and returns headlines plus photos. It does not send
# a written summary. finnhub and alpha_vantage include a summary when a
# key is set. none skips news.
NEWS_PROVIDER=
FINNHUB_API_KEY=
NEWS_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:18421
