# Copy to `.env` for local (non-Docker) runs.
# Docker Compose sets equivalent values for the `api` service itself.
# Never commit a real `.env`.

APP_NAME=FinSight
ENVIRONMENT=local
LOG_LEVEL=INFO

# Host process talking to Postgres published on localhost:15432
# Inside Compose, the API uses host `db` instead of `localhost`.
DATABASE_URL=postgresql+psycopg://finsight:finsight@localhost:15432/finsight

# Analytics (Sharpe). Annual decimal; 0.05 = 5%. Not a forecast.
RISK_FREE_RATE=0.05
TRADING_DAYS_PER_YEAR=252
