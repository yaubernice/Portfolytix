# Copy to `.env` for local (non-Docker) runs.
# Docker Compose sets equivalent values for the `api` service itself.
# Never commit a real `.env`.

APP_NAME=FinSight
ENVIRONMENT=local
LOG_LEVEL=INFO

# Host process talking to Postgres published on localhost:15432
# Inside Compose, the API uses host `db` instead of `localhost`.
DATABASE_URL=postgresql+psycopg://finsight:finsight@localhost:15432/finsight

# Analytics (Sharpe). Annual decimal; 0.05 = 5%. Not a forecast.
RISK_FREE_RATE=0.05
TRADING_DAYS_PER_YEAR=252

# Market data. stooq needs no key. alpha_vantage needs MARKET_DATA_API_KEY.
MARKET_DATA_PROVIDER=stooq
MARKET_DATA_API_KEY=

# Phase 6 scheduler. 22:00 UTC is after the US cash close (EST and EDT).
SCHEDULER_ENABLED=true
MARKET_DATA_CRON=0 22 * * *
MARKET_DATA_LOOKBACK_DAYS=7
JOB_STALE_AFTER_SECONDS=3600

# Phase 9 cache. Host Redis is published on 16379; Compose uses redis:6379.
CACHE_ENABLED=true
REDIS_URL=redis://localhost:16379/0
CACHE_KEY_PREFIX=finsight
ANALYTICS_CACHE_TTL_SECONDS=300
SCREENING_CACHE_TTL_SECONDS=300
REDIS_SOCKET_TIMEOUT_SECONDS=0.2
